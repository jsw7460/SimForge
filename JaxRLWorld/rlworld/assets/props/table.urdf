<?xml version="1.0"?>
<!-- Workbench for a bench-mounted arm: a 1.2 x 0.8 x 0.4 slab whose top
     face sits 0.4 m above the link origin's z when the body is placed at
     z = 0.2. Loaded as a non-floating rigid object, so it never moves. -->
<robot name="table">
  <link name="table">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="3.3333" ixy="0" ixz="0" iyy="6.6667" iyz="0" izz="8.6667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="1.2 0.8 0.4"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="1.2 0.8 0.4"/></geometry>
    </collision>
  </link>
</robot>
