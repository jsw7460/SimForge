<?xml version="1.0"?>
<!-- Graspable workpiece: a 40 mm cube at 50 g, sized to fit between the
     YAM gripper's pads and light enough for the crank gripper's clamped
     force limit to hold. Loaded as a floating rigid object. -->
<robot name="cube">
  <link name="cube">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.3333e-5" ixy="0" ixz="0" iyy="1.3333e-5" iyz="0" izz="1.3333e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
  </link>
</robot>
